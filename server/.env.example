# Copy to .env (never commit it).

# Postgres connection string. With Supabase: Connect > Session pooler (or Direct connection), with your
# database password filled in. Keep the real value ONLY in server/.env, never in this file.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# "require" for hosted databases (Supabase), "disable" for a local Postgres.
DATABASE_SSL=require

# Long random string used to sign access tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000

# Public https URL of this server (Google redirects the browser back to it). Needed for Google sign-in.
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated app URL schemes the Google flow may redirect back to.
APP_REDIRECT_SCHEMES=asta
