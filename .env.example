# Copy to .env.local and fill in. Never commit real values.

# Base URL of the Express API (see server/). A phone cannot reach "localhost": in development use your
# PC's LAN address, e.g. http://192.168.1.20:3000 (find it with `ipconfig`); in production the https URL.
EXPO_PUBLIC_API_URL=

# Android only: Google Maps SDK key used by react-native-maps (read in app.config.ts at build time)
GOOGLE_MAPS_ANDROID_API_KEY=
